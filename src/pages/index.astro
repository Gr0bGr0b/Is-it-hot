---

const res2 = await fetch(`https://ipinfo.io/json?token=${import.meta.env.SECRET_IP_TOKEN}`);
const data2 = await res2.json()
const lon = data2.loc ?? data2.loc.split(',')[0] : 0
const lat = data2.loc ?? data2.loca.split(',')[1] : 0 
const response = await fetch(`https://api.openweathermap.org/data/2.5/weather?units=metric&lat=${lat}&lon=${lon}&appid=${import.meta.env.SECRET_WEATHER_API}`)
const data = await response.json()
const temperature = data.main.temp;

const isItHot = () => {
  if(!temperature) return 'Looks like your are in space';
  if (temperature < 0){
     return 'Is is quite the opposite !';
  } else if (temperature > 0 && temperature < 25) {
    return 'No, it is not.'
  } else {
      return 'Yes it is...'; 
  }
}

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
	</head>
  <title>Is it hot ?</title>
	<body>
    <div class="container">
     <div class="temp">
       {temperature.toFixed()}<span class="unit">°C</span>
     </div> 
    <div class="center">
      {isItHot()}
    </div>
    </div>
	</body>
</html>

<style>
 .container {
            display: flex;
            justify-content: center;
            flex-direction: column;
            align-items: center;
            height: 100vh; 
        }
        .center {
          width: max-width;
            font-size: 24px;
        }

        .temp {
  font-size: clamp(8rem, 30vw, 18rem);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.04em;
}

.unit {
  font-size: 0.5em;
  vertical-align: super;
}
</style>
